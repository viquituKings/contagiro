# Configuração do Firebase para Expo (as variáveis com prefixo EXPO_PUBLIC_ são lidas automaticamente pelo Expo)
EXPO_PUBLIC_FIREBASE_API_KEY=sua_api_key_aqui
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu_projeto_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu_projeto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=seu_app_id

# (Opcional) Google Sign-In para Android e Web
# Obtenha no Console do Firebase > Authentication > Sign-in method > Google > Configuração do SDK da Web
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=seu_client_id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=seu_client_id.apps.googleusercontent.com
