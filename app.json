{
  "expo": {
    "name": "ContaGiro",
    "slug": "contagiro",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "contagiro",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.reistech.contagiro",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#101D2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101D2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "O ContaGiro precisa de acesso às suas fotos para definir fotos do veículo e avatar de perfil.",
          "cameraPermission": "O ContaGiro precisa de acesso à câmera para fotografar seu veículo ou avatar.",
          "microphonePermission": false
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "defaultChannel": "manutencoes"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9967c17e-2044-4687-a6ab-f597ceb5ae95"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reistech.contagiro",
      "buildNumber": "3"
    }
  }
}
